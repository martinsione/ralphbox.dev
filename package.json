{
  "name": "ralphbox",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "git config --local core.hooksPath .githooks",
    "cli": "bun run --filter @ralphbox/cli build:agent > /dev/null && bun run packages/cli/src/cli.ts",
    "format": "oxfmt .",
    "typecheck": "turbo run typecheck --log-order=grouped",
    "test": "turbo run test --log-order=grouped"
  },
  "devDependencies": {
    "@types/bun": "1.3.8",
    "oxfmt": "0.27.0",
    "turbo": "2.8.1"
  },
  "packageManager": "bun@1.3.8"
}
