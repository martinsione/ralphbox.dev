{
  "name": "ralphbox",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "git config --local core.hooksPath .githooks",
    "cli": "bun --filter @ralphbox/cli build:agent && bun --target=bun packages/cli/src/cli.ts",
    "web": "PORT=8643 bun --filter @ralphbox/web dev",
    "format": "oxfmt .",
    "typecheck": "turbo run typecheck --log-order=grouped",
    "test": "turbo run test --log-order=grouped"
  },
  "devDependencies": {
    "@types/bun": "1.3.8",
    "oxfmt": "0.27.0",
    "turbo": "2.8.1"
  },
  "packageManager": "bun@1.3.8"
}
