{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bun format || true"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bun run format:*)",
      "Bash(bun run test:*)",
      "Bash(bun run typecheck:*)",
      "Bash(bunx opensrc:*)",
      "Bash(grep:*)",
      "Bash(ln:*)",
      "Bash(ls:*)",
      "Bash(npx opensrc:*)"
    ]
  }
}
